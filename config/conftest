server {
    listen 8080;
    server_name localhost;

    root ./www/html;
    index index.html;
    error_page 404 /404.html;
    client_max_body_size 1000000;

    location / {
        root ./www/html;
        autoindex off;
    }

    Cgi_Interpreter .py /usr/bin/python3
    Cgi_Interpreter .pl /usr/bin/perl
    Cgi_Interpreter .sh /usr/bin/sh
}
