server {
    listen 10;
    server_name localhost;

    root /var/www/html;
    index index.html;
    client_max_body_size 1000000;

    location / {
        root /var/www/html;
        autoindex off;
    }
}

server {
    listen 80;
    server_name localhost;

    root /var/www/html;
    index index.html;
    client_max_body_size 1000000;

    location / {
        root /var/www/html;
        autoindex off;
    }
}

