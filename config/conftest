server {
    listen 8080;
    server_name localhost;

    root ./www;
    index index.html;
    error_page 404 /404.html;
    client_max_body_size 1000000;

    location / {
        root ./www/html;
        autoindex off;
    }

    cgi_interpreter .py /usr/bin/python3
    cgi_interpreter .pl /usr/bin/perl
    cgi_interpreter .sh /usr/bin/sh
}
