server {
    listen 8080;
    server_name localhost;

    root /var/www/html;
    index index.html;
    client_max_body_size 1000000;

    location / {
        root /var/www/html;
        autoindex off;
    }
    Cgi_Interpreter .py /use/bin/pyhton3
    Cgi_Interpreter .pl /use/bin/perl
    Cgi_Interpreter .sh /use/bin/sh
}
