server {
    listen 8080;
    listen 9000;
    server_name localhost;

    root ./www/html;
    index index.html;
    client_max_body_size 1000000;

    location / {
        root ./www/html;
        autoindex off;
    }

}

server {
    listen 8081;
    server_name localhost;

    root ./www/html;
