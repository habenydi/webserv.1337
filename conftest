server {
    listen 8080;
    server_name localhost;

    root /var/www/html;
    index index.html;
    client_max_body_size 1000000;

    location / {
        root /var/www/html;
        autoindex off;
    }
}

server {
    listen 8081;
    server_name test.local;

    root /var/www/testsite;
    index home.html;
    client_max_body_size 500000;

    error_page 404 /notfound.html;

    location /uploads {
        root /var/www/testsite/uploads;
        autoindex on;
    }
}
