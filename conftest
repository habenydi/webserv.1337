server {
    listen 8080;
    host 127.0.0.1;

    server_name myserver;

    root ./www;
    index index.html;

    error_page 404 /errors/404.html;

    client_max_body_size 1000000;

    location / {
        root ./www;
        index index.html;
        autoindex off;
        allow_methods GET;
    }

    location /upload {
        root ./uploads;
        allow_methods POST GET;
    }

    location /delete {
        root ./www;
        allow_methods DELETE;
    }
}
